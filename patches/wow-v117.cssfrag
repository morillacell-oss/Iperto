/* JUNTA V117 — cinematic premium refinement */
:root{--wow-red:#ff3f38;--wow-red-deep:#e9272b;--wow-ink:#17110f;--wow-cream:#fffaf7;--wow-glass:rgba(255,255,255,.78);--wow-border:rgba(72,39,27,.075);--wow-shadow:0 22px 65px rgba(53,27,18,.09)}
::selection{background:#ffded9;color:#b91f22}html{scroll-behavior:smooth}body{background:radial-gradient(900px 420px at 5% -8%,rgba(255,74,66,.12),transparent 58%),radial-gradient(800px 420px at 96% 5%,rgba(255,189,164,.14),transparent 58%),linear-gradient(180deg,#fff9f6,#fffdfc 40%,#fff9f7);background-attachment:fixed}.j-app{position:relative}.j-app:before{content:"";position:fixed;inset:76px 0 auto;height:260px;pointer-events:none;background:linear-gradient(180deg,rgba(255,255,255,.18),transparent);z-index:-1}.j-topbar{background:rgba(255,250,247,.72);border-bottom-color:rgba(63,33,23,.055);box-shadow:0 10px 40px rgba(45,24,17,.035)}.j-topbar-inner{min-height:78px}.j-brand{font-weight:950}.j-brand span:last-child{background:linear-gradient(135deg,#17110f 20%,#4c2720 100%);-webkit-background-clip:text;background-clip:text;color:transparent}.j-icon-btn,.j-avatar-btn{background:rgba(255,255,255,.82);backdrop-filter:blur(14px);border:1px solid rgba(63,34,24,.07);box-shadow:0 10px 26px rgba(52,28,19,.055),inset 0 1px rgba(255,255,255,.9)}
.j-view{padding-bottom:28px}.j-view>.j-shell,.j-view.j-shell{position:relative}.j-section-head h2,.j-panel h2,.j-buyer-header h1,.j-business-info h1{letter-spacing:-.055em;text-wrap:balance}.j-section-head p,.j-panel p{line-height:1.55}.j-kicker{font-size:10px;letter-spacing:.14em;border-radius:999px}.j-btn{font-weight:900}.j-btn.primary{position:relative;overflow:hidden}.j-btn.primary:after{content:"";position:absolute;inset:0;background:linear-gradient(110deg,transparent 15%,rgba(255,255,255,.22) 45%,transparent 70%);transform:translateX(-130%);transition:transform .55s ease}.j-btn.primary:hover:after{transform:translateX(130%)}
.j-region-card,.j-business-hero,.j-account-card,.j-panel{border:1px solid var(--wow-border);box-shadow:var(--wow-shadow);backdrop-filter:blur(8px)}.j-region-card{padding:24px;background:radial-gradient(circle at 90% 8%,rgba(255,68,61,.13),transparent 31%),linear-gradient(145deg,rgba(255,255,255,.98),rgba(255,246,242,.94))}.j-region-card strong{font-size:clamp(20px,4vw,28px);letter-spacing:-.04em}.j-business-hero{padding:26px}.j-business-logo{outline:5px solid rgba(255,255,255,.68)}
.j-metrics{grid-template-columns:repeat(auto-fit,minmax(150px,1fr))}.j-metric{padding:20px;min-height:152px}.j-metric span{font-size:11px;font-weight:850;letter-spacing:.07em;text-transform:uppercase}.j-metric strong{font-size:clamp(34px,6vw,46px);letter-spacing:-.065em}.j-metric.hot:before{content:"";position:absolute;inset:0;background:linear-gradient(120deg,transparent,rgba(255,255,255,.12),transparent);transform:translateX(-100%);animation:jWowSheen 4.8s ease-in-out infinite}@keyframes jWowSheen{0%,55%{transform:translateX(-100%)}80%,100%{transform:translateX(100%)}}
.j-offer{background:rgba(255,255,255,.94);overflow:hidden}.j-offer-img{height:200px;background:linear-gradient(145deg,#f8f2ef,#fff)}.j-offer-img img{width:100%;height:100%;object-fit:cover}.j-offer-body{padding:18px}.j-offer h3{font-size:19px}.j-offer-prices strong{font-size:24px}.j-progress{height:9px;border-radius:99px;overflow:hidden}.j-progress i{background:linear-gradient(90deg,#ff5a51,#ed292c)}.j-card-cta{min-height:46px;border-radius:14px;font-weight:900}.j-badge{font-weight:950;letter-spacing:.025em}
.j-list-item{background:linear-gradient(180deg,#fff,#fffdfc);padding:14px}.j-list-img{box-shadow:0 7px 20px rgba(52,28,19,.08)}.j-status{font-weight:900}.j-chart{border-radius:20px;background:linear-gradient(180deg,#fffaf8,#fff);padding:12px}.j-chart-col i{border-radius:10px 10px 5px 5px;background:linear-gradient(180deg,#ff5a51,#e9292d)}
.j-completion-alert{position:relative;overflow:hidden;border:1px solid rgba(255,255,255,.22);background:radial-gradient(circle at 90% 10%,rgba(255,255,255,.2),transparent 30%),linear-gradient(135deg,#ff5149,#e9272b);box-shadow:0 22px 50px rgba(226,39,39,.24)}.j-completion-alert:after{content:"";position:absolute;width:160px;height:160px;border-radius:50%;border:1px solid rgba(255,255,255,.13);right:-65px;bottom:-105px}.j-completion-alert>*{position:relative;z-index:1}.j-achieved-panel{background:radial-gradient(circle at 94% 5%,rgba(255,78,68,.12),transparent 34%),linear-gradient(145deg,#fff1ee,#fffaf8 70%);border-radius:25px!important}.j-achieved-panel h3{letter-spacing:-.05em}.j-achieved-run-card{background:linear-gradient(180deg,#fff,#fffdfc);border-radius:26px;box-shadow:0 16px 42px rgba(48,26,18,.06)}.j-achieved-count{background:linear-gradient(145deg,#fff2ef,#ffe8e4)}
.j-modal{max-height:min(92dvh,900px);overflow:auto;scrollbar-width:thin;scrollbar-color:#e9d7d0 transparent}.j-modal::-webkit-scrollbar{width:6px}.j-modal::-webkit-scrollbar-thumb{background:#e9d7d0;border-radius:99px}.j-modal-head{position:relative}.j-close{background:#fff;border:1px solid rgba(69,38,27,.08);box-shadow:0 7px 18px rgba(52,28,19,.05)}.j-tier-choice{min-height:74px}.j-tier-choice.selected{transform:translateY(-1px)}.j-tier-choice-price strong{letter-spacing:-.04em}.j-order-summary-top{background:radial-gradient(circle at 92% 5%,rgba(255,72,64,.09),transparent 34%),linear-gradient(145deg,#fff2ef,#fffaf8)}.j-checkout-steps span.active{box-shadow:0 7px 18px rgba(235,48,44,.08)}.j-order-protection{border-radius:18px}.j-success-mark{box-shadow:0 14px 32px rgba(20,151,102,.18)}
.j-bottom-nav{max-width:560px}.j-bottom-nav button{font-weight:850}.j-bottom-nav button svg{transition:transform .18s ease}.j-bottom-nav button.active svg{transform:translateY(-1px) scale(1.06)}
.j-form input,.j-form select,.j-form textarea{min-height:52px}.j-form label{gap:7px}.j-form input:focus,.j-form select:focus,.j-form textarea:focus{border-color:rgba(255,62,55,.45)!important;box-shadow:0 0 0 4px rgba(255,62,55,.09)!important}.j-toast{border-radius:16px!important;box-shadow:0 18px 48px rgba(31,18,13,.22)!important;backdrop-filter:blur(14px)}
@media(min-width:900px){.j-offer-grid{gap:20px}.j-panel{padding:24px}.j-view{padding-top:26px}.j-business-hero{padding:30px}.j-region-card{padding:28px}}
@media(max-width:640px){.j-shell{width:min(100% - 22px,1200px)}.j-topbar-inner{min-height:68px}.j-icon-btn,.j-avatar-btn{width:44px;height:44px}.j-brand{font-size:23px}.j-view{padding-top:16px}.j-region-card,.j-panel,.j-account-card,.j-business-hero{border-radius:24px}.j-region-card{padding:19px}.j-metrics{gap:10px}.j-metric{min-height:128px;padding:16px;border-radius:21px}.j-metric strong{font-size:34px}.j-offer{border-radius:23px}.j-offer-img{height:178px}.j-offer-body{padding:15px}.j-modal{border-radius:26px 26px 0 0!important}.j-bottom-nav{width:calc(100% - 18px);bottom:max(8px,env(safe-area-inset-bottom));border-radius:23px}.j-bottom-nav button{min-height:57px}.j-completion-alert{border-radius:20px;padding:14px}.j-achieved-run-card{border-radius:22px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.j-view,.j-metric.hot:before{animation:none!important}.j-btn.primary:after{display:none}.j-offer,.j-icon-btn,.j-avatar-btn,.j-bottom-nav button svg{transition:none!important}}
