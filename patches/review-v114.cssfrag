.j-achieved-panel{position:relative;overflow:hidden;padding:20px;border-radius:24px;background:linear-gradient(145deg,#fff0ee 0%,#fff8f6 58%,#fff 100%);border:1px solid rgba(239,53,50,.14);box-shadow:0 16px 36px rgba(239,53,50,.08)}.j-achieved-panel:before{content:"";position:absolute;right:-44px;top:-58px;width:150px;height:150px;border-radius:50%;background:rgba(255,67,61,.08)}.j-achieved-panel>span{color:#ef3532}.j-achieved-panel h3{font-size:24px;line-height:1.05;letter-spacing:-.025em}.j-achieved-panel p{color:#685d58}.j-checkout-modal{max-height:92dvh;overflow:auto;overscroll-behavior:contain;padding-bottom:max(18px,env(safe-area-inset-bottom))}.j-checkout-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:4px 0 18px}.j-checkout-steps span{display:flex;align-items:center;justify-content:center;gap:6px;min-height:38px;border-radius:12px;background:#f8f4f2;color:#7d716c;font-size:11px;font-weight:850}.j-checkout-steps span:before{display:grid;place-items:center;width:20px;height:20px;border-radius:50%;background:#fff;color:#ef3532;font-size:10px;font-weight:950;box-shadow:0 2px 7px rgba(34,20,15,.06)}.j-checkout-steps span:nth-child(1):before{content:"1"}.j-checkout-steps span:nth-child(2):before{content:"2"}.j-checkout-steps span:nth-child(3):before{content:"3"}.j-checkout-steps span.active{background:#fff0ee;color:#e8322f}.j-order-summary-top{border:1px solid rgba(239,53,50,.10);box-shadow:0 8px 24px rgba(61,31,20,.04)}.j-checkout-modal .j-form>label{font-weight:850;color:#403633}.j-checkout-modal .j-form input,.j-checkout-modal .j-form select,.j-checkout-modal .j-form textarea{width:100%;border:1px solid #eadfda;background:#fff;border-radius:15px;min-height:50px;padding:0 14px;outline:none;transition:border-color .16s ease,box-shadow .16s ease,background .16s ease}.j-checkout-modal .j-form textarea{padding-top:13px;resize:vertical}.j-checkout-modal .j-form input:focus,.j-checkout-modal .j-form select:focus,.j-checkout-modal .j-form textarea:focus{border-color:#ff5a55;box-shadow:0 0 0 4px rgba(255,75,68,.10);background:#fff}.j-checkout-modal #groupOrderForm>button[type=submit]{position:sticky;bottom:max(8px,env(safe-area-inset-bottom));z-index:3;min-height:56px;margin-top:12px;box-shadow:0 14px 28px rgba(239,53,50,.23)}.j-order-protection{border:1px solid #eee4df;background:#fbf8f6}.j-order-protection:before{content:"✓";width:24px;height:24px;border-radius:50%;display:grid;place-items:center;background:#eafff5;color:#0d8b61;font-weight:950;margin-bottom:2px}.j-completion-alert{background:linear-gradient(135deg,#ff3f39,#e92c29);box-shadow:0 16px 36px rgba(235,46,43,.22)}.j-completion-alert small{color:#ffe1df}.j-completion-alert em{color:#fff0ee}.j-achieved-run-card{padding:18px;border-radius:24px;border-color:#eadfda;box-shadow:0 12px 32px rgba(53,31,24,.055)}.j-achieved-run-head>div:first-child>span{display:inline-flex;align-items:center;gap:5px;padding:6px 9px;border-radius:999px;background:#eafff5;color:#0f825d}.j-achieved-count{min-width:76px;padding:10px 12px;border-radius:16px;background:#fff2f0}.j-achieved-count strong{color:#ef3532}.j-run-progress{height:10px}.j-run-progress i{background:linear-gradient(90deg,#ff433e,#ee332f)}.j-seller-order{background:#fff;border-color:#eee3de;box-shadow:0 7px 22px rgba(40,24,18,.035)}.j-seller-order-top{align-items:flex-start}.j-order-status{font-weight:900}.j-order-status.status-confirmed{background:#fff4db;color:#8d6510}.j-order-status.status-preparing{background:#fff0ee;color:#d93631}.j-order-status.status-whatsapp_opened{background:#eef7ff;color:#176a9a}.j-seller-order .j-btn{min-height:46px;border-radius:14px}.j-whatsapp-missing-card,.j-seller-whatsapp-warning{box-shadow:0 8px 22px rgba(91,61,26,.05)}.j-btn:disabled{opacity:.55;cursor:not-allowed;transform:none!important}.j-btn,.j-tier-choice,.j-card-cta,.j-completion-alert{touch-action:manipulation;-webkit-tap-highlight-color:transparent}@media(max-width:560px){.j-checkout-modal{max-height:94dvh;border-radius:26px 26px 0 0}.j-checkout-steps{gap:5px}.j-checkout-steps span{font-size:10px;min-height:36px;padding:0 4px}.j-order-summary-top{align-items:flex-start}.j-achieved-run-head{align-items:flex-start}.j-achieved-count{min-width:70px}.j-seller-order-top{display:grid;grid-template-columns:1fr auto}.j-checkout-modal #groupOrderForm>button[type=submit]{bottom:max(6px,env(safe-area-inset-bottom))}}@media(prefers-reduced-motion:reduce){.j-checkout-modal .j-form input,.j-checkout-modal .j-form select,.j-checkout-modal .j-form textarea,.j-btn,.j-tier-choice{transition:none!important;animation:none!important}}