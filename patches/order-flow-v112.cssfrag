.j-completion-alert{width:100%;display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center;text-align:left;border:0;border-radius:22px;padding:16px 18px;margin:0 0 16px;background:linear-gradient(135deg,#17110f,#2a1b16);color:#fff;box-shadow:0 14px 35px rgba(36,19,13,.18);cursor:pointer}.j-completion-alert-icon{width:44px;height:44px;border-radius:14px;background:rgba(255,255,255,.12);display:grid;place-items:center;font-size:22px}.j-completion-alert span:nth-child(2){display:grid;gap:3px}.j-completion-alert small{font-size:10px;font-weight:900;letter-spacing:.14em;color:#ffaaa5}.j-completion-alert strong{font-size:16px}.j-completion-alert em{font-style:normal;font-size:12px;color:#ddd0ca;line-height:1.4}.j-completion-alert>b{font-size:12px;white-space:nowrap}.j-my-target.achieved{background:linear-gradient(135deg,#ecfff6,#f7fffb);border:1px solid #b9ecd7}.j-my-target.achieved>span{color:#12845f}.j-offer-achieved{box-shadow:0 18px 42px rgba(22,151,108,.10)!important}.j-badge.success{background:#e8fff5!important;color:#0a7a55!important}.j-card-cta.success{background:#129b6d!important;color:#fff!important}.j-achieved-panel{margin:16px 0;padding:18px;border-radius:20px;background:linear-gradient(135deg,#eafff6,#f9fffc);border:1px solid #b9ecd7}.j-achieved-panel>span{font-size:11px;font-weight:950;letter-spacing:.12em;color:#12845f}.j-achieved-panel h3{margin:6px 0;font-size:23px}.j-achieved-panel p{margin:0 0 14px;color:#5d6863;line-height:1.5}.j-tier-choice.locked{opacity:.68}.j-tier-choice.locked:disabled{cursor:not-allowed}.j-tier-choice.locked.selected{opacity:1;border-color:#22a879;background:#effff8}.j-checkout-modal{width:min(720px,100%)}.j-checkout-modal .j-modal-head p{margin:6px 0 0;color:var(--muted);line-height:1.45}.j-order-summary-top{display:flex;justify-content:space-between;gap:14px;align-items:center;padding:16px 18px;border-radius:18px;background:#fff3f1;margin-bottom:16px}.j-order-summary-top div{display:grid;gap:4px}.j-order-summary-top small{font-weight:800;color:#756864}.j-order-summary-top strong{font-size:28px;color:#ef3532}.j-order-summary-top>span{font-size:12px;font-weight:900;padding:8px 10px;border-radius:999px;background:#fff;color:#342925}.j-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.j-field-help{display:block;margin-top:7px;color:#8a7f79;font-size:11px;line-height:1.4}.j-order-protection{display:grid;gap:4px;padding:14px 16px;border-radius:16px;background:#f7f3f1;color:#594f4a}.j-order-protection b{font-size:13px}.j-order-protection span{font-size:12px;line-height:1.45}.j-whatsapp-missing{margin:0;text-align:center;font-size:12px;line-height:1.5;color:#7d6e67}.j-order-success,.j-order-detail{text-align:left}.j-order-success>.j-success-mark{margin:0 auto 12px}.j-order-success>h2,.j-order-success>p{text-align:center}.j-order-recap{display:grid;gap:10px;margin:18px 0}.j-order-recap>div{display:grid;gap:3px;padding:13px 14px;border-radius:14px;background:#faf7f5}.j-order-recap span{font-size:10px;font-weight:900;letter-spacing:.08em;color:#8b7d77}.j-order-recap strong{font-size:14px;line-height:1.4}.j-whatsapp-missing-card{display:grid;gap:5px;padding:15px;border-radius:16px;background:#fff4db;border:1px solid #f1d59c;margin:14px 0}.j-whatsapp-missing-card b{color:#8c6110}.j-whatsapp-missing-card span{font-size:12px;line-height:1.45;color:#6f5a31}.j-order-status-big{display:grid;gap:5px;padding:18px;border-radius:18px;background:linear-gradient(135deg,#fff1ef,#fff9f7);margin:12px 0 16px}.j-order-status-big span{font-size:11px;font-weight:900;letter-spacing:.1em;color:#e63c37}.j-order-status-big strong{font-size:30px}.j-order-status-big small{color:#7c706a}.j-seller-whatsapp-warning{display:flex;gap:14px;justify-content:space-between;align-items:center;padding:16px;margin:16px 0;border-radius:18px;background:#fff5e5;border:1px solid #f1d39a}.j-seller-whatsapp-warning div{display:grid;gap:4px}.j-seller-whatsapp-warning b{font-size:15px}.j-seller-whatsapp-warning span{font-size:12px;line-height:1.45;color:#6d5b38}.j-seller-whatsapp-warning .j-btn{width:auto;flex:0 0 auto}.j-completed-groups{margin-top:16px}.j-achieved-run-list{display:grid;gap:14px}.j-achieved-run-card{border:1px solid #e9dfda;border-radius:22px;padding:16px;background:#fff}.j-achieved-run-head{display:flex;justify-content:space-between;gap:14px;align-items:flex-start}.j-achieved-run-head>div:first-child>span{font-size:10px;font-weight:950;letter-spacing:.1em;color:#11845f}.j-achieved-run-head h3{margin:5px 0 3px;font-size:20px}.j-achieved-run-head p{margin:0;color:#766c67;font-size:13px}.j-achieved-count{text-align:right;display:grid}.j-achieved-count strong{font-size:25px}.j-achieved-count small{color:#857a75;font-size:11px}.j-run-progress{height:8px;border-radius:999px;background:#f1ebe8;overflow:hidden;margin:14px 0 7px}.j-run-progress i{display:block;height:100%;background:linear-gradient(90deg,#ff4a43,#16a373);border-radius:inherit}.j-run-progress-meta{display:flex;justify-content:space-between;gap:12px;font-size:11px;color:#81756f}.j-order-list{display:grid;gap:10px;margin-top:14px}.j-seller-order{padding:14px;border-radius:16px;background:#faf8f7;border:1px solid #eee5e1}.j-seller-order-top{display:flex;justify-content:space-between;gap:10px;align-items:center}.j-seller-order-top>div{display:grid;gap:3px}.j-seller-order-top span{font-size:10px;color:#8a7c76;font-weight:900}.j-seller-order-top strong{font-size:15px}.j-order-status{font-size:10px;padding:7px 9px;border-radius:999px;background:#fff0ee;color:#db3b36}.j-order-status.status-delivered{background:#e9fff6;color:#087952}.j-order-status.status-ready{background:#eef7ff;color:#176a9a}.j-seller-order-data{display:grid;gap:8px;margin:12px 0}.j-seller-order-data p{margin:0;display:grid;gap:2px}.j-seller-order-data small{font-size:9px;letter-spacing:.08em;font-weight:900;color:#998b84}.j-seller-order-data strong{font-size:12px;line-height:1.45}.j-empty.compact{padding:18px;margin-top:12px}.j-empty.compact h3{font-size:16px;margin:0}.j-empty.compact p{font-size:12px}.j-seller-order .j-btn{width:100%;min-height:42px}.j-checkout-modal select,.j-checkout-modal textarea,.j-checkout-modal input{font-size:16px}@media(max-width:560px){.j-form-grid{grid-template-columns:1fr}.j-completion-alert{grid-template-columns:auto 1fr}.j-completion-alert>b{display:none}.j-seller-whatsapp-warning{align-items:stretch;flex-direction:column}.j-seller-whatsapp-warning .j-btn{width:100%}.j-achieved-run-head{align-items:center}.j-order-summary-top strong{font-size:24px}}