/* JUNTA V121 — YouTube-style buyer intro */
.j-buyer-video-hero{display:block!important;position:relative!important;width:100%!important;max-width:880px!important;margin:18px auto 26px!important;overflow:hidden!important;border:1px solid rgba(70,42,31,.08)!important;border-radius:24px!important;background:#fff!important;box-shadow:0 18px 46px rgba(49,27,19,.10)!important;min-height:0!important;grid-template-columns:none!important}
.j-buyer-video-frame{position:relative!important;width:100%!important;min-width:0!important;height:auto!important;min-height:0!important;aspect-ratio:16/9!important;background:#000!important;overflow:hidden!important;border-radius:0!important}
.j-welcome-video{display:block!important;width:100%!important;height:100%!important;aspect-ratio:16/9!important;object-fit:contain!important;background:#000!important;filter:none!important}
.j-video-dismiss{position:absolute!important;z-index:9!important;right:12px!important;top:12px!important;width:36px!important;height:36px!important;border:0!important;border-radius:50%!important;background:rgba(20,17,15,.72)!important;color:#fff!important;font:800 24px/1 system-ui!important;box-shadow:0 6px 20px rgba(0,0,0,.18)!important;backdrop-filter:blur(10px)!important;display:grid!important;place-items:center!important}
.j-video-duration,.j-video-live,.j-video-steps{display:none!important}
.j-buyer-video-copy{display:block!important;padding:14px 16px 16px!important;background:#fff!important}
.j-video-eyebrow{display:inline-flex!important;align-items:center!important;gap:7px!important;color:#e83431!important;font-size:9px!important;font-weight:950!important;letter-spacing:.10em!important}
.j-video-eyebrow i{width:7px!important;height:7px!important;border-radius:50%!important;background:#ef3f3a!important;box-shadow:0 0 0 4px rgba(239,63,58,.10)!important}
.j-buyer-video-copy h2{margin:7px 0 5px!important;font-size:20px!important;line-height:1.12!important;letter-spacing:-.035em!important;color:#17120f!important;max-width:none!important}
.j-buyer-video-copy p{margin:0!important;max-width:none!important;color:#7a706b!important;font-size:12.5px!important;line-height:1.45!important}
@media(max-width:760px){
  .j-buyer-shell{padding-top:22px!important}
  .j-buyer-video-hero{max-width:none!important;margin:14px 0 22px!important;border-radius:20px!important}
  .j-buyer-video-frame{width:100%!important;min-width:0!important;height:auto!important;min-height:0!important;aspect-ratio:16/9!important}
  .j-welcome-video{width:100%!important;height:100%!important;object-fit:contain!important}
  .j-buyer-video-copy{padding:13px 14px 15px!important}
  .j-buyer-video-copy h2{font-size:18px!important;margin:6px 0 4px!important}
  .j-buyer-video-copy p{font-size:11.8px!important;line-height:1.4!important;display:block!important;overflow:visible!important}
  .j-video-dismiss{right:9px!important;top:9px!important;width:32px!important;height:32px!important;font-size:21px!important}
}
@media(max-width:390px){
  .j-buyer-video-hero{border-radius:18px!important}
  .j-buyer-video-copy{padding:12px 13px 14px!important}
  .j-buyer-video-copy h2{font-size:17px!important}
  .j-buyer-video-copy p{font-size:11px!important}
}
