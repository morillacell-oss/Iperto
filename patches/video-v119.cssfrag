/* JUNTA V119 — compact buyer intro on mobile */
@media(max-width:760px){
  .j-buyer-video-hero{display:grid!important;grid-template-columns:142px minmax(0,1fr)!important;align-items:stretch!important;gap:0!important;border-radius:24px!important;min-height:142px!important}
  .j-buyer-video-frame{width:142px!important;min-width:142px!important;height:100%!important;min-height:142px!important;aspect-ratio:auto!important}
  .j-welcome-video{width:100%!important;height:100%!important;object-fit:cover!important}
  .j-buyer-video-copy{padding:16px 15px!important;justify-content:center!important}
  .j-video-eyebrow{font-size:8px!important;letter-spacing:.08em!important}
  .j-buyer-video-copy h2{font-size:22px!important;line-height:1!important;margin:9px 0 7px!important;letter-spacing:-.05em!important}
  .j-buyer-video-copy p{font-size:10.8px!important;line-height:1.4!important;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
  .j-video-steps{display:none!important}
  .j-video-duration{left:9px!important;top:9px!important;padding:6px 7px!important;font-size:7px!important}
  .j-video-live{left:9px!important;bottom:9px!important;padding:6px 7px!important;font-size:7px!important}
  .j-video-dismiss{right:8px!important;top:8px!important;width:29px!important;height:29px!important;font-size:18px!important}
}
@media(max-width:390px){
  .j-buyer-video-hero{grid-template-columns:124px minmax(0,1fr)!important;min-height:128px!important}
  .j-buyer-video-frame{width:124px!important;min-width:124px!important;min-height:128px!important}
  .j-buyer-video-copy{padding:13px 12px!important}
  .j-buyer-video-copy h2{font-size:20px!important}
  .j-buyer-video-copy p{font-size:10px!important;-webkit-line-clamp:3}
}
