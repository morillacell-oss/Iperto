/* JUNTA V118 — buyer layout repair + premium onboarding */
:root{--v118-red:#f33b35;--v118-red-deep:#e5292b;--v118-ink:#181311;--v118-muted:#756963;--v118-line:rgba(77,44,31,.09);--v118-card:#fff;--v118-soft:#fff5f2;--v118-shadow:0 18px 50px rgba(52,28,19,.08)}
.j-buyer-shell{padding-top:16px!important;padding-bottom:calc(132px + env(safe-area-inset-bottom))!important;overflow:visible}.j-buyer-header-v118{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;padding:12px 2px 18px!important}.j-buyer-header-v118>div{min-width:0}.j-buyer-header-v118 h1{font-size:clamp(34px,5vw,54px)!important;line-height:.98;margin:10px 0 9px!important;letter-spacing:-.065em}.j-buyer-header-v118 p{margin:0;max-width:690px;line-height:1.55}.j-buyer-trust{flex:0 0 auto;padding:10px 13px;border:1px solid var(--v118-line);border-radius:999px;background:rgba(255,255,255,.82);font-size:11px;font-weight:900;color:#5e5049;box-shadow:0 8px 20px rgba(48,27,19,.035)}
.j-buyer-region-card{margin-bottom:14px!important;border-radius:26px!important;border:1px solid var(--v118-line)!important;background:radial-gradient(circle at 92% 6%,rgba(255,67,59,.10),transparent 27%),linear-gradient(145deg,#fff,#fff9f7)!important;box-shadow:0 14px 34px rgba(52,28,19,.055)!important}.j-region-pin{box-shadow:inset 0 1px rgba(255,255,255,.9),0 8px 18px rgba(238,50,45,.08)}.j-region-change{box-shadow:0 10px 22px rgba(25,18,15,.12);transition:transform .15s ease,box-shadow .15s ease}.j-region-change:active{transform:scale(.98)}
.j-buyer-video-hero{display:grid;grid-template-columns:minmax(0,1.42fr) minmax(300px,.78fr);gap:0;overflow:hidden;margin:16px 0 24px;border:1px solid var(--v118-line);border-radius:30px;background:linear-gradient(145deg,#fff,#fff9f7);box-shadow:0 22px 58px rgba(55,29,20,.09)}.j-buyer-video-frame{position:relative;min-width:0;background:#171210;aspect-ratio:16/9;overflow:hidden}.j-welcome-video{display:block;width:100%;height:100%;object-fit:cover;background:#171210}.j-video-duration{position:absolute;right:14px;top:14px;padding:7px 9px;border-radius:999px;background:rgba(18,13,11,.72);backdrop-filter:blur(9px);color:#fff;font-size:9px;font-weight:950;letter-spacing:.08em;pointer-events:none}.j-buyer-video-copy{display:flex;flex-direction:column;justify-content:center;padding:28px}.j-video-eyebrow{display:inline-flex;align-items:center;gap:8px;align-self:flex-start;color:#e6322f;font-size:10px;font-weight:950;letter-spacing:.11em}.j-video-eyebrow i{width:8px;height:8px;border-radius:50%;background:#f13d37;box-shadow:0 0 0 6px rgba(241,61,55,.10)}.j-buyer-video-copy h2{margin:13px 0 10px;font-size:clamp(27px,3vw,39px);line-height:.98;letter-spacing:-.055em}.j-buyer-video-copy p{margin:0;color:var(--v118-muted);line-height:1.55;font-size:14px}.j-video-steps{display:grid;gap:8px;margin-top:18px}.j-video-steps span{display:flex;align-items:center;gap:10px;padding:10px 11px;border-radius:14px;background:#fff;border:1px solid rgba(76,43,30,.07);font-size:12px;font-weight:850;color:#403530}.j-video-steps b{display:grid;place-items:center;width:24px;height:24px;border-radius:9px;background:#fff0ed;color:#e83330;font-size:11px}
.j-buyer-body-v118{margin-top:18px!important}.j-buyer-section-head{margin:24px 2px 14px!important}.j-buyer-section-head .j-kicker{position:static!important;max-width:100%;white-space:normal}.j-buyer-section-head h2{font-size:clamp(27px,4vw,36px)!important;line-height:1.02;margin:10px 0 7px!important}.j-buyer-section-head p{max-width:720px!important;font-size:14px!important;line-height:1.5!important}.j-buyer-grid{display:grid!important;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr))!important;align-items:start!important;gap:20px!important}
.j-buyer-promo-card{display:block!important;width:100%!important;max-width:100%!important;min-width:0!important;border:1px solid var(--v118-line)!important;border-radius:30px!important;background:var(--v118-card)!important;overflow:hidden!important;box-shadow:0 18px 48px rgba(54,29,20,.075)!important;isolation:isolate;transform:none!important}.j-buyer-promo-card:hover{transform:translateY(-2px)!important;box-shadow:0 24px 58px rgba(54,29,20,.10)!important}.j-buyer-promo-card:active{transform:scale(.996)!important}.j-buyer-card-media{position:relative!important;width:100%!important;height:auto!important;min-height:0!important;aspect-ratio:16/10!important;overflow:hidden!important;background:#f3ece8!important}.j-buyer-card-media:after{content:"";position:absolute;inset:auto 0 0;height:38%;background:linear-gradient(180deg,transparent,rgba(25,14,10,.16));z-index:1;pointer-events:none}.j-buyer-card-media img{position:absolute!important;inset:0!important;display:block!important;width:100%!important;max-width:none!important;height:100%!important;object-fit:cover!important;object-position:center!important}.j-buyer-card-badges{position:absolute!important;z-index:3!important;top:14px!important;left:14px!important;right:14px!important;display:flex!important;align-items:flex-start!important;justify-content:space-between!important;gap:8px!important;pointer-events:none}.j-buyer-card-badges .j-badge,.j-saving-badge{position:static!important;inset:auto!important;display:inline-flex!important;align-items:center!important;min-height:32px!important;max-width:calc(60% - 4px)!important;padding:8px 10px!important;border-radius:999px!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important;font-size:9px!important;line-height:1!important;font-weight:950!important;letter-spacing:.045em!important;box-shadow:0 8px 20px rgba(28,17,13,.14)!important}.j-buyer-card-badges .j-badge.open{background:rgba(24,18,16,.86)!important;color:#fff!important;border-color:rgba(255,255,255,.16)!important;backdrop-filter:blur(10px)}.j-buyer-card-badges .j-badge.success{background:rgba(224,255,242,.95)!important;color:#087751!important;border-color:rgba(255,255,255,.5)!important}.j-saving-badge{justify-content:center!important;background:rgba(255,255,255,.94)!important;color:#e4312f!important;border:1px solid rgba(255,255,255,.64)!important;backdrop-filter:blur(10px)}
.j-buyer-card-body{padding:18px 18px 19px!important}.j-store-line{display:flex!important;align-items:center!important;gap:10px!important;margin:0 0 12px!important;min-width:0!important}.j-store-logo{width:38px!important;height:38px!important;border-radius:13px!important;box-shadow:0 7px 17px rgba(50,28,19,.08);border:1px solid rgba(68,39,28,.06)}.j-store-line div{min-width:0}.j-store-line small{font-size:9px!important;letter-spacing:.09em!important}.j-store-line strong{display:block;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:14px!important}.j-buyer-card-body h3{margin:0 0 16px!important;font-size:clamp(23px,3.3vw,29px)!important;line-height:1.04!important;letter-spacing:-.045em!important;text-align:left!important;color:var(--v118-ink)!important}.j-price-showcase{display:grid;grid-template-columns:minmax(105px,.75fr) minmax(0,1.25fr);gap:10px;margin-bottom:12px}.j-price-showcase>div{min-width:0;border-radius:19px;padding:13px 14px;text-align:left}.j-price-normal{background:#faf6f4;border:1px solid rgba(79,47,34,.045)}.j-price-best{background:linear-gradient(145deg,#fff0ed,#fff7f5);border:1px solid rgba(242,55,50,.09)}.j-price-showcase small{display:block;margin-bottom:7px;color:#958881;font-size:8.5px;font-weight:950;letter-spacing:.075em;line-height:1.2}.j-price-normal s{font-size:16px;color:#9d938e}.j-price-best strong{display:block;color:#ed342f;font-size:clamp(24px,5vw,32px);line-height:1;letter-spacing:-.045em}.j-price-best em{display:block;margin-top:7px;color:#a34b43;font-size:9.5px;font-style:normal;font-weight:850}.j-first-tier,.j-my-target{margin:0 0 13px!important}.j-progress-wrap{padding-top:2px}.j-buyer-card-body .j-progress{margin-top:0!important;height:9px!important}.j-buyer-card-body .j-progress-meta{margin-top:7px!important;font-size:10.5px!important}.j-progress-copy{margin:9px 0 13px!important;color:#716660!important;font-size:11px!important;line-height:1.45!important;min-height:0!important}.j-card-cta{display:flex!important;align-items:center!important;justify-content:space-between!important;width:100%!important;min-height:52px!important;padding:0 16px!important;border-radius:16px!important;background:linear-gradient(135deg,#ff4a43,#ec292c)!important;color:#fff!important;font-size:14px!important;font-weight:950!important;box-shadow:0 12px 25px rgba(236,41,44,.18)!important}.j-card-cta.success{background:linear-gradient(135deg,#18a56f,#0b885a)!important;box-shadow:0 12px 25px rgba(13,139,91,.16)!important}.j-card-cta b{font-size:20px!important}.j-safe-copy{display:block!important;margin:9px 2px 0!important;text-align:center!important;color:#9a8e88!important;font-size:9.5px!important;line-height:1.35!important}
.j-bottom-nav{width:min(560px,calc(100% - 20px))!important;bottom:max(8px,env(safe-area-inset-bottom))!important;padding:7px!important;border-radius:25px!important}.j-bottom-nav button{min-width:0!important;min-height:59px!important;padding:5px 3px!important}.j-bottom-nav button span,.j-bottom-nav button{white-space:nowrap}.j-local-discovery{margin-top:0!important}.j-local-discovery+.j-flash-stack{margin-top:14px}
@media(max-width:760px){.j-buyer-header-v118{align-items:flex-start}.j-buyer-trust{display:none}.j-buyer-video-hero{grid-template-columns:1fr}.j-buyer-video-copy{padding:20px}.j-video-steps{grid-template-columns:repeat(3,1fr);gap:7px}.j-video-steps span{display:grid;justify-items:start;align-content:start;gap:7px;min-height:82px;padding:10px;font-size:10.5px;line-height:1.2}.j-buyer-grid{grid-template-columns:1fr!important}.j-buyer-promo-card{border-radius:27px!important}.j-buyer-card-media{aspect-ratio:1.36/1!important}.j-buyer-card-body{padding:17px!important}}
@media(max-width:520px){.j-shell{width:calc(100% - 22px)!important}.j-app-shell{padding-top:8px!important}.j-buyer-header-v118{padding:7px 1px 15px!important}.j-buyer-header-v118 h1{font-size:37px!important}.j-buyer-header-v118 p{font-size:13px;line-height:1.45}.j-buyer-region-card{grid-template-columns:42px minmax(0,1fr)!important;gap:11px!important;padding:13px!important;border-radius:22px!important}.j-region-pin{width:42px!important;height:42px!important;border-radius:14px!important}.j-region-copy h2{font-size:18px!important}.j-region-copy p{font-size:11.5px!important}.j-region-change{grid-column:1/-1!important;width:100%!important;min-height:44px!important}.j-buyer-video-hero{margin:13px 0 20px;border-radius:24px}.j-video-duration{right:10px;top:10px}.j-buyer-video-copy{padding:17px}.j-buyer-video-copy h2{font-size:28px;margin-top:12px}.j-buyer-video-copy p{font-size:12.5px}.j-video-steps{grid-template-columns:1fr 1fr 1fr}.j-video-steps span{min-height:76px;padding:9px;font-size:9.7px}.j-buyer-section-head{margin:20px 1px 12px!important}.j-buyer-section-head h2{font-size:30px!important}.j-buyer-section-head p{font-size:13px!important}.j-buyer-card-badges{top:11px!important;left:11px!important;right:11px!important;flex-direction:column!important;align-items:flex-start!important;justify-content:flex-start!important}.j-buyer-card-badges .j-badge,.j-saving-badge{max-width:90%!important;min-height:29px!important;padding:7px 9px!important;font-size:8.5px!important}.j-buyer-card-media{aspect-ratio:1.28/1!important}.j-buyer-card-body h3{font-size:25px!important}.j-price-showcase{grid-template-columns:.8fr 1.2fr;gap:8px}.j-price-showcase>div{padding:12px}.j-price-best strong{font-size:27px}.j-bottom-nav{width:calc(100% - 16px)!important}.j-bottom-nav button{font-size:9.5px!important;min-height:58px!important}}
@media(max-width:350px){.j-video-steps{grid-template-columns:1fr}.j-video-steps span{display:flex;min-height:auto}.j-price-showcase{grid-template-columns:1fr}.j-buyer-card-media{aspect-ratio:1.2/1!important}.j-bottom-nav button{font-size:9px!important}}
@media(prefers-reduced-motion:reduce){.j-buyer-promo-card,.j-region-change{transition:none!important}}
