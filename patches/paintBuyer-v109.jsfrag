  function tierMemberCount(o,people){
    const s=statsOf(o);
    return Number(s?.[`tier_${Number(people)}_count`]||0);
  }

  function tierRemaining(o,people){
    return Math.max(0,Number(people||0)-tierMemberCount(o,people));
  }

  function paintBuyer(tab){
    const root=$('#buyerBody');if(!root)return;
    const membership=new Map(state.buyerWaitlist.map(x=>[x.offer_id,x]));
    const activeJoined=new Set(state.buyerWaitlist.filter(x=>x.status!=='cancelled').map(x=>x.offer_id));
    const offers=state.buyerOffers;
    if(tab==='groups'){
      const rows=offers.filter(o=>membership.has(o.id)).sort((a,b)=>(a.status==='cancelled')-(b.status==='cancelled'));
      root.innerHTML=rows.length?`<div class="j-buyer-section-head"><span class="j-kicker">MEUS GRUPOS</span><h2>Acompanhe suas metas.</h2><p>Veja exatamente em qual faixa você entrou e quantas pessoas ainda faltam.</p></div><div class="j-grid j-buyer-grid">${rows.map(o=>buyerOfferCard(o,activeJoined.has(o.id),membership.get(o.id))).join('')}</div>`:`<div class="j-empty"><h3>Você ainda não entrou em nenhum grupo.</h3><p>Explore ofertas da sua região e escolha uma meta de preço.</p></div>`;
    } else {
      const activeOffers=offers.filter(o=>o.status!=='cancelled');
      const flash=activeOffers.filter(o=>o.price_flash_until&&new Date(o.price_flash_until)>new Date());
      if(!activeOffers.length){
        root.innerHTML=`<div class="j-empty j-buyer-empty"><span class="j-kicker">SUA REGIÃO</span><h3>No momento não há ofertas por perto.</h3><p>Quando um comércio aprovado abrir um grupo na sua região, ele vai aparecer aqui.</p></div>`;
      }else{
        const featured=flash[0]||activeOffers[0];
        const city=state.profile?.city||'sua região';
        const discovery=tab==='home'?localDiscoveryBanner(featured,activeOffers.length,city):`<div class="j-buyer-section-head"><span class="j-kicker">EXPLORAR</span><h2>Grupos abertos na sua região.</h2><p>Escolha sua meta, acompanhe quantas pessoas faltam e convide amigos.</p></div>`;
        root.innerHTML=`${discovery}${flash.length?`<div class="j-flash-stack">${flash.map(flashCard).join('')}</div>`:''}<div class="j-buyer-section-head j-buyer-offers-head"><span class="j-kicker">PERTO DE VOCÊ</span><h2>${activeOffers.length===1?'1 grupo aberto agora':`${activeOffers.length} grupos abertos agora`}</h2><p>Escolha a faixa que você quer alcançar. Entrar no grupo não cobra nada agora.</p></div><div class="j-grid j-buyer-grid">${activeOffers.map(o=>buyerOfferCard(o,activeJoined.has(o.id),membership.get(o.id))).join('')}</div>`;
      }
    }
    $$('[data-buyer-offer]',root).forEach(b=>b.onclick=()=>openBuyerOffer(offers.find(o=>o.id===b.dataset.buyerOffer)));
    const sharedId=new URLSearchParams(location.search).get('offer');
    if(sharedId&&state._sharedOpened!==sharedId){
      const shared=offers.find(o=>o.id===sharedId);
      if(shared){state._sharedOpened=sharedId;setTimeout(()=>openBuyerOffer(shared),60);}
    }
  }

  function localDiscoveryBanner(o,count,city){
    const b=businessOf(o),title=esc(o.title),store=esc(b.name||'um comércio local');
    return `<section class="j-local-discovery"><div class="j-local-orb one"></div><div class="j-local-orb two"></div><div class="j-local-content"><span class="j-local-label"><i></i>PROMOÇÃO ENCONTRADA NA SUA REGIÃO</span><h2>${count===1?'Olha o que apareceu perto de você 👀':`Encontramos ${count} oportunidades perto de você`}</h2><p>${store} abriu um grupo para <strong>${title}</strong> em ${esc(city)}. Escolha sua meta de preço e convide amigos para completar mais rápido.</p><div class="j-local-proof"><span>ESCOLHA SUA META</span><span>ENTRAR NÃO COBRA</span><span>COMPARTILHE COM AMIGOS</span></div></div></section>`;
  }

  function buyerOfferCard(o,joined,membership){
    const cancelled=o.status==='cancelled'||membership?.status==='cancelled';
    const s=statsOf(o),w=Number(s.waitlist_count||0),target=Number(o.queue_target||25),p=pct(w,target),b=businessOf(o),tiers=tiersOf(o);
    const firstTier=tiers[0],bestTier=tiers[tiers.length-1];
    const regular=Number(o.regular_price||0),firstPrice=Number(firstTier?.unit_price||o.junta_price||0),bestPrice=Number(bestTier?.unit_price||o.junta_price||0),saving=Math.max(0,regular-bestPrice);
    const selectedTarget=Number(membership?.target_people||0);
    const selectedTier=tiers.find(t=>Number(t.people_count)===selectedTarget);
    const selectedRemaining=selectedTarget?tierRemaining(o,selectedTarget):0;
    if(cancelled){
      return `<button class="j-offer j-buyer-promo-card j-offer-cancelled" data-buyer-offer="${o.id}"><div class="j-offer-img">${o.image_url?`<img src="${esc(o.image_url)}" alt="${esc(o.title)}">`:''}<span class="j-badge cancelled">GRUPO CANCELADO</span></div><div class="j-offer-body"><div class="j-offer-store">${esc(b.name||'Comércio')}</div><h3>${esc(o.title)}</h3><div class="j-cancelled-note"><strong>GRUPO CANCELADO</strong><span>INCOMPLETO</span><small>${esc(membership?.cancellation_reason||o.cancel_reason||'Este grupo foi encerrado pelo vendedor.')}</small></div></div></button>`;
    }
    const progressText=w===0?'Grupo começando agora — seja um dos primeiros':w===1?'1 pessoa já entrou nesta oferta':`${w} pessoas já entraram nesta oferta`;
    return `<button class="j-offer j-buyer-promo-card" data-buyer-offer="${o.id}">
      <div class="j-offer-img j-buyer-card-media">${o.image_url?`<img src="${esc(o.image_url)}" alt="${esc(o.title)}">`:''}<div class="j-buyer-card-badges"><span class="j-badge open">GRUPO ABERTO</span>${saving>0?`<span class="j-saving-badge">ECONOMIZE ATÉ ${money(saving)}</span>`:''}</div></div>
      <div class="j-offer-body j-buyer-card-body"><div class="j-store-line">${b.logo_url?`<span class="j-store-logo"><img src="${esc(b.logo_url)}" alt="${esc(b.name||'Loja')}"></span>`:''}<div><small>OFERTA DE</small><strong>${esc(b.name||'Comércio local')}</strong></div></div><h3>${esc(o.title)}</h3>
      <div class="j-buyer-price-block"><div><small>PREÇO NORMAL</small><s>${money(regular)}</s></div><div><small>PODE CHEGAR A</small><strong>${money(bestPrice)}</strong></div></div>
      ${joined?(selectedTarget&&selectedTier?`<div class="j-my-target"><span>SUA META</span><strong>${selectedTarget} pessoas · ${money(selectedTier.unit_price)}</strong><small>${selectedRemaining===0?'Meta completa':selectedRemaining===1?'Falta 1 pessoa':`Faltam ${selectedRemaining} pessoas`}</small></div>`:`<div class="j-my-target needs-choice"><span>FALTA ESCOLHER</span><strong>Escolha sua meta de preço</strong><small>Seu cadastro antigo está no grupo, mas ainda sem uma faixa definida.</small></div>`):(firstTier?`<div class="j-first-tier"><span>Primeira meta</span><strong>${firstTier.people_count} pessoas → ${money(firstPrice)}</strong></div>`:'')}
      <div class="j-progress"><i style="width:${p}%"></i></div><div class="j-progress-meta"><span>${w} pessoas na oferta</span><span>${Math.max(0,target-w)} até 25</span></div><p class="j-progress-copy">${progressText}</p>
      <span class="j-card-cta">${joined?'Acompanhar minha meta':'Escolher meta e entrar'} <b>→</b></span><small class="j-safe-copy">Você escolhe a faixa antes de entrar. Sem cobrança agora.</small></div>
    </button>`;
  }