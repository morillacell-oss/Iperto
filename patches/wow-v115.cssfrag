/* JUNTA V115 — premium visual refinement */
:root{--wow-red:#f33a35;--wow-red2:#ff5a52;--wow-ink:#211915;--wow-muted:#786b65;--wow-line:rgba(55,34,25,.09);--wow-bg:#fffaf7;--wow-card:rgba(255,255,255,.92);--wow-shadow:0 20px 55px rgba(66,35,23,.09);--wow-shadow-sm:0 9px 28px rgba(66,35,23,.065)}
html{background:var(--wow-bg);scroll-behavior:smooth}body{background:radial-gradient(circle at 8% 0%,rgba(255,91,81,.065),transparent 28rem),linear-gradient(180deg,#fffdfb 0,#fffaf7 46%,#fff 100%);color:var(--wow-ink);-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}.j-app{min-height:calc(100dvh - 68px)}
.j-topbar{background:rgba(255,252,249,.82)!important;backdrop-filter:blur(22px) saturate(1.25);-webkit-backdrop-filter:blur(22px) saturate(1.25);border-bottom:1px solid rgba(62,35,25,.055)!important;box-shadow:0 7px 30px rgba(48,26,18,.035)!important}.j-topbar-inner{min-height:70px}.j-brand{letter-spacing:.07em!important}.j-brand-mark{filter:drop-shadow(0 5px 9px rgba(243,58,53,.16))}.j-icon-btn,.j-avatar-btn{border:1px solid rgba(54,32,24,.08)!important;background:rgba(255,255,255,.9)!important;box-shadow:0 6px 18px rgba(52,29,21,.055)!important}.j-avatar-btn{background:linear-gradient(145deg,#ff544d,#e92f2b)!important;color:#fff!important;border-color:transparent!important}
.j-shell{width:min(1180px,calc(100% - 32px))}.j-panel,.j-card,.j-stat-card,.j-metric-card,.j-offer-card,.j-achieved-run-card{border-color:var(--wow-line)!important;box-shadow:var(--wow-shadow-sm)!important}.j-panel{background:rgba(255,255,255,.88)!important;backdrop-filter:blur(10px);border-radius:28px!important}.j-card,.j-offer-card{transition:transform .22s cubic-bezier(.2,.8,.2,1),box-shadow .22s ease,border-color .22s ease}.j-card:hover,.j-offer-card:hover{transform:translateY(-3px);box-shadow:var(--wow-shadow)!important;border-color:rgba(243,58,53,.13)!important}
.j-kicker{display:inline-flex!important;align-items:center;gap:7px;color:var(--wow-red)!important;font-weight:950!important;letter-spacing:.13em!important}.j-kicker:before{content:"";width:7px;height:7px;border-radius:50%;background:linear-gradient(135deg,var(--wow-red2),var(--wow-red));box-shadow:0 0 0 5px rgba(243,58,53,.08)}h1,h2,h3,.j-title{letter-spacing:-.035em!important}.j-panel h2,.j-section-head h2{line-height:1.02!important}.j-panel p,.j-section-head p{color:var(--wow-muted)}
.j-btn{border-radius:15px!important;font-weight:900!important;letter-spacing:-.01em;transition:transform .16s ease,box-shadow .18s ease,filter .18s ease!important}.j-btn:not(:disabled):active{transform:scale(.975)!important}.j-btn.primary{border:0!important;background:linear-gradient(135deg,#ff5049 0%,#ee302c 60%,#df2825 100%)!important;box-shadow:0 12px 28px rgba(239,48,44,.22)!important;color:#fff!important}.j-btn.primary:hover{filter:saturate(1.08) brightness(1.02);box-shadow:0 16px 34px rgba(239,48,44,.28)!important}.j-btn.secondary{background:#fff!important;border:1px solid rgba(54,32,24,.09)!important;box-shadow:0 7px 18px rgba(48,27,20,.045)!important}.j-card-cta{border-radius:14px!important;min-height:44px;font-weight:900!important}
.j-tabbar{background:rgba(255,255,255,.78)!important;backdrop-filter:blur(18px);border-color:rgba(58,35,27,.07)!important}.j-tabbar button.active{background:linear-gradient(145deg,#fff0ee,#ffe5e2)!important;color:#e92e2a!important;box-shadow:0 8px 20px rgba(239,47,45,.10)!important}
.j-bottom-nav{background:rgba(255,252,249,.9)!important;backdrop-filter:blur(24px) saturate(1.25);-webkit-backdrop-filter:blur(24px) saturate(1.25);border-top:1px solid rgba(54,32,24,.07)!important;box-shadow:0 -14px 40px rgba(50,27,19,.06)!important}.j-bottom-nav button{transition:transform .16s ease,color .16s ease}.j-bottom-nav button.active{color:var(--wow-red)!important}.j-bottom-nav button.active svg{filter:drop-shadow(0 4px 7px rgba(243,58,53,.16))}
.j-offer-card img,.j-offer-modal-img{background:#f6f1ee}.j-offer-card img{transition:transform .35s cubic-bezier(.2,.8,.2,1)}.j-offer-card:hover img{transform:scale(1.025)}.j-badge{border:1px solid rgba(255,255,255,.7);box-shadow:0 4px 14px rgba(42,24,18,.06)}.j-progress,.j-run-progress{background:#f1e9e5!important}.j-progress i,.j-run-progress i{background:linear-gradient(90deg,#ff5b53,#ed302c)!important;box-shadow:0 0 12px rgba(243,58,53,.16)}
.j-tier-choice{border-radius:18px!important;border-color:#eadfda!important;background:linear-gradient(180deg,#fff,#fffcfa)!important;box-shadow:0 6px 17px rgba(52,31,23,.035);transition:transform .16s ease,border-color .16s ease,box-shadow .16s ease!important}.j-tier-choice:not(:disabled):hover{transform:translateY(-2px);border-color:rgba(243,58,53,.25)!important;box-shadow:0 11px 26px rgba(57,31,22,.07)}.j-tier-choice.selected{border-color:#ff5b54!important;background:linear-gradient(145deg,#fff4f2,#fff)!important;box-shadow:0 0 0 3px rgba(243,58,53,.07),0 12px 28px rgba(57,31,22,.065)!important}.j-tier-radio{box-shadow:inset 0 0 0 1px rgba(52,31,23,.08)}
.j-overlay{background:rgba(31,20,16,.34)!important;backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}.j-modal{border:1px solid rgba(255,255,255,.72)!important;box-shadow:0 35px 100px rgba(39,20,14,.22)!important}.j-close{background:#f8f3f0!important;border:1px solid rgba(54,32,24,.06)!important;transition:transform .16s ease,background .16s ease}.j-close:hover{transform:rotate(5deg);background:#fff0ee!important}.j-form input,.j-form select,.j-form textarea{transition:border-color .16s ease,box-shadow .16s ease,background .16s ease!important}.j-form input:focus,.j-form select:focus,.j-form textarea:focus{border-color:#ff5a54!important;box-shadow:0 0 0 4px rgba(243,58,53,.09)!important}
.j-toast{border:1px solid rgba(255,255,255,.14)!important;background:rgba(35,25,21,.94)!important;backdrop-filter:blur(16px);box-shadow:0 18px 50px rgba(28,16,12,.22)!important;border-radius:16px!important}.j-completion-alert{position:relative;overflow:hidden;background:linear-gradient(125deg,#ff4d46,#e92e2a)!important;border:1px solid rgba(255,255,255,.16)!important;box-shadow:0 18px 42px rgba(235,46,43,.22)!important}.j-completion-alert:after{content:"";position:absolute;width:130px;height:130px;border-radius:50%;right:-55px;top:-75px;background:rgba(255,255,255,.12)}
.j-achieved-panel{background:radial-gradient(circle at 100% 0,rgba(255,73,66,.10),transparent 12rem),linear-gradient(145deg,#fff1ef,#fff 72%)!important}.j-achieved-run-card{background:linear-gradient(180deg,#fff,#fffcfa)!important}.j-order-summary-top{background:linear-gradient(135deg,#fff0ee,#fff7f5)!important}.j-order-status-big{background:radial-gradient(circle at 95% 0,rgba(255,79,71,.09),transparent 10rem),linear-gradient(145deg,#fff0ee,#fff)!important}
.j-stat-card,.j-metric-card{position:relative;overflow:hidden;background:linear-gradient(160deg,#fff,#fffcfa)!important}.j-stat-card:after,.j-metric-card:after{content:"";position:absolute;width:75px;height:75px;border-radius:50%;right:-36px;top:-40px;background:rgba(243,58,53,.045)}
@media(max-width:700px){.j-shell{width:min(100% - 22px,1180px)}.j-topbar-inner{min-height:64px}.j-panel{border-radius:23px!important}.j-card:hover,.j-offer-card:hover{transform:none}.j-modal{box-shadow:0 -18px 60px rgba(39,20,14,.18)!important}.j-bottom-nav{padding-bottom:max(7px,env(safe-area-inset-bottom))!important}}
@media(prefers-reduced-motion:no-preference){@keyframes wowIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}.j-panel,.j-offer-card,.j-completion-alert{animation:wowIn .36s ease both}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.j-card,.j-offer-card,.j-btn,.j-tier-choice{transition:none!important}.j-panel,.j-offer-card,.j-completion-alert{animation:none!important}}
