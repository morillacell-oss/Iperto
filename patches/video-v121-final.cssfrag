/* JUNTA V121 final video override — must load after V120 */
.j-buyer-video-hero{display:block!important;position:relative!important;width:100%!important;max-width:880px!important;margin:16px auto 24px!important;overflow:hidden!important;border:1px solid rgba(70,42,31,.08)!important;border-radius:22px!important;background:#fff!important;box-shadow:0 16px 42px rgba(49,27,19,.09)!important;min-height:0!important;grid-template-columns:none!important}
.j-buyer-video-frame{position:relative!important;width:100%!important;min-width:0!important;height:auto!important;min-height:0!important;aspect-ratio:16/9!important;background:#000!important;overflow:hidden!important;border-radius:0!important}
.j-welcome-video{display:block!important;width:100%!important;height:100%!important;aspect-ratio:16/9!important;object-fit:contain!important;background:#000!important;filter:none!important}
.j-video-duration,.j-video-live,.j-video-steps{display:none!important}
.j-video-dismiss{position:absolute!important;z-index:9!important;right:10px!important;top:10px!important;width:34px!important;height:34px!important;border:0!important;border-radius:50%!important;background:rgba(15,13,12,.72)!important;color:#fff!important;font:800 22px/1 system-ui!important;display:grid!important;place-items:center!important;box-shadow:0 6px 20px rgba(0,0,0,.18)!important;backdrop-filter:blur(9px)!important}
.j-buyer-video-copy{display:block!important;padding:13px 15px 15px!important;background:#fff!important}
.j-video-eyebrow{display:inline-flex!important;align-items:center!important;gap:7px!important;color:#e83431!important;font-size:8.5px!important;font-weight:950!important;letter-spacing:.10em!important}
.j-video-eyebrow i{width:7px!important;height:7px!important;border-radius:50%!important;background:#ef3f3a!important;box-shadow:0 0 0 4px rgba(239,63,58,.10)!important}
.j-buyer-video-copy h2{margin:6px 0 4px!important;font-size:19px!important;line-height:1.12!important;letter-spacing:-.035em!important;color:#17120f!important;max-width:none!important}
.j-buyer-video-copy p{margin:0!important;max-width:none!important;color:#786e69!important;font-size:12px!important;line-height:1.4!important;display:block!important;overflow:visible!important}
@media(max-width:620px){
  .j-buyer-shell{padding-top:20px!important}
  .j-buyer-video-hero{max-width:none!important;margin:13px 0 21px!important;border-radius:18px!important}
  .j-buyer-video-frame{width:100%!important;min-width:0!important;height:auto!important;min-height:0!important;aspect-ratio:16/9!important}
  .j-welcome-video{width:100%!important;height:100%!important;object-fit:contain!important}
  .j-buyer-video-copy{padding:12px 13px 14px!important}
  .j-buyer-video-copy h2{font-size:17.5px!important;margin:5px 0 3px!important}
  .j-buyer-video-copy p{font-size:11px!important;line-height:1.38!important}
  .j-video-dismiss{right:8px!important;top:8px!important;width:31px!important;height:31px!important;font-size:20px!important}
}
