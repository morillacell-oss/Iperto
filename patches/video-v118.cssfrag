/* JUNTA V118 video polish */
.j-buyer-video-hero{position:relative;grid-template-columns:minmax(210px,.78fr) minmax(0,1.22fr)!important;min-height:0;transition:opacity .18s ease,transform .18s ease}.j-buyer-video-frame{aspect-ratio:16/9!important;align-self:stretch;min-height:190px}.j-welcome-video{image-rendering:auto;filter:saturate(1.03) contrast(1.02)}.j-video-dismiss{position:absolute;z-index:8;right:13px;top:13px;width:34px;height:34px;border:1px solid rgba(255,255,255,.72);border-radius:50%;background:rgba(255,255,255,.9);color:#342824;font:700 22px/1 system-ui;box-shadow:0 8px 24px rgba(35,20,14,.15);backdrop-filter:blur(12px);cursor:pointer}.j-video-live{position:absolute;z-index:3;left:14px;bottom:14px;display:inline-flex;align-items:center;gap:7px;padding:7px 10px;border-radius:999px;background:rgba(20,15,13,.68);color:#fff;font-size:8px;font-weight:950;letter-spacing:.09em;backdrop-filter:blur(10px)}.j-video-live i{width:6px;height:6px;border-radius:50%;background:#ff4a43;box-shadow:0 0 0 4px rgba(255,74,67,.2)}.j-buyer-video-copy{padding:26px 30px!important}.j-buyer-video-copy h2{font-size:clamp(29px,3.2vw,43px)!important;max-width:520px}.j-buyer-video-copy p{max-width:570px}.j-video-steps{grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}.j-video-steps span{min-width:0}.j-video-duration{right:auto!important;left:14px!important;top:14px!important}
@media(max-width:760px){.j-buyer-video-hero{grid-template-columns:1fr!important}.j-buyer-video-frame{min-height:0}.j-buyer-video-copy{padding:19px!important}.j-video-dismiss{right:10px;top:10px}.j-video-duration{left:10px!important;top:10px!important}.j-video-live{left:10px;bottom:10px}}
@media(max-width:520px){.j-buyer-video-frame{aspect-ratio:16/9!important}.j-buyer-video-copy h2{font-size:29px!important}.j-video-steps span{min-height:68px!important}.j-video-dismiss{width:32px;height:32px;font-size:20px}}
