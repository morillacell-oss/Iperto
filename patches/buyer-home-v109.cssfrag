/* V109 — buyer local discovery experience */
.j-buyer-shell{padding-bottom:120px}.j-buyer-header-v109{margin-bottom:14px}.j-buyer-header-v109 h1{margin-bottom:8px}.j-buyer-header-v109 p{max-width:640px}
.j-buyer-region-card{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:14px;padding:16px 18px;border:1px solid #eaded8;border-radius:24px;background:linear-gradient(180deg,#fff 0%,#fffaf8 100%);box-shadow:0 10px 28px rgba(66,38,27,.055)}
.j-region-pin{width:48px;height:48px;border-radius:16px;display:grid;place-items:center;background:#fff0ed;color:#ef3732}.j-region-pin svg{width:23px;height:23px;fill:none;stroke:currentColor;stroke-width:1.9}.j-region-copy{min-width:0}.j-region-copy h2{font-size:20px;letter-spacing:-.03em;margin:4px 0 3px}.j-region-copy p{margin:0;color:var(--muted);font-size:13px;line-height:1.4}.j-region-change{appearance:none;border:0;background:#181311;color:#fff;border-radius:14px;padding:12px 14px;font-size:13px;font-weight:900;white-space:nowrap;cursor:pointer;touch-action:manipulation}
.j-local-discovery{position:relative;overflow:hidden;padding:24px;border-radius:28px;background:linear-gradient(135deg,#ff443f 0%,#ef2928 72%,#d91f22 100%);color:#fff;box-shadow:0 18px 42px rgba(231,45,42,.20);margin:4px 0 22px}.j-local-content{position:relative;z-index:2}.j-local-label{display:inline-flex;align-items:center;gap:8px;padding:8px 11px;border-radius:999px;background:rgba(255,255,255,.16);font-size:11px;font-weight:950;letter-spacing:.085em}.j-local-label i{width:8px;height:8px;border-radius:50%;background:#fff;box-shadow:0 0 0 6px rgba(255,255,255,.12);animation:jLocalPulse 1.8s ease-in-out infinite}.j-local-discovery h2{font-size:clamp(26px,6vw,38px);line-height:1.02;letter-spacing:-.045em;margin:16px 0 10px;max-width:620px}.j-local-discovery p{margin:0;max-width:620px;font-size:15px;line-height:1.55;color:rgba(255,255,255,.9)}.j-local-proof{display:flex;flex-wrap:wrap;gap:7px;margin-top:17px}.j-local-proof span{padding:8px 10px;border:1px solid rgba(255,255,255,.22);border-radius:999px;background:rgba(255,255,255,.1);font-size:10px;font-weight:900;letter-spacing:.06em}.j-local-orb{position:absolute;border-radius:50%;border:20px solid rgba(255,255,255,.1);pointer-events:none}.j-local-orb.one{width:170px;height:170px;right:-45px;top:-65px}.j-local-orb.two{width:90px;height:90px;right:90px;bottom:-55px}@keyframes jLocalPulse{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(.72);opacity:.72}}
.j-buyer-section-head{margin:18px 0 12px}.j-buyer-section-head h2{font-size:27px;letter-spacing:-.04em;margin:5px 0 4px}.j-buyer-section-head p{margin:0;color:var(--muted);font-size:14px;line-height:1.45}.j-buyer-offers-head{padding:0 2px}.j-buyer-grid{gap:16px}
.j-buyer-promo-card{overflow:hidden;border:1px solid #eadfd9;background:#fff;box-shadow:0 14px 34px rgba(58,34,24,.075);border-radius:26px;transition:transform .18s ease,box-shadow .18s ease}.j-buyer-promo-card:active{transform:scale(.992)}.j-buyer-card-media{position:relative;height:230px;background:#f4efec}.j-buyer-card-media img{width:100%;height:100%;object-fit:cover}.j-buyer-card-badges{position:absolute;left:14px;right:14px;top:14px;display:flex;align-items:flex-start;justify-content:space-between;gap:8px}.j-badge.open{position:static;background:#181311;color:#fff}.j-saving-badge{padding:8px 10px;border-radius:999px;background:#fff;color:#df2b29;font-size:10px;font-weight:950;box-shadow:0 8px 18px rgba(0,0,0,.12)}
.j-buyer-card-body{padding:18px}.j-store-line{display:flex;align-items:center;gap:9px;margin-bottom:11px;text-align:left}.j-store-logo{width:34px;height:34px;border-radius:11px;overflow:hidden;background:#f5efec;flex:0 0 auto}.j-store-logo img{width:100%;height:100%;object-fit:cover}.j-store-line div{display:grid}.j-store-line small{font-size:9px;font-weight:900;color:#9c8f88;letter-spacing:.08em}.j-store-line strong{font-size:13px;color:#2a211d}.j-buyer-card-body h3{font-size:24px;letter-spacing:-.035em;margin:0 0 15px;text-align:left}.j-buyer-price-block{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px}.j-buyer-price-block>div{padding:12px 13px;border-radius:16px;background:#faf6f4;text-align:left}.j-buyer-price-block small{display:block;font-size:9px;color:#968983;font-weight:900;letter-spacing:.07em;margin-bottom:4px}.j-buyer-price-block s{font-size:15px;color:#9f9692}.j-buyer-price-block strong{font-size:24px;color:#ef3833;letter-spacing:-.03em}.j-first-tier{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 12px;border-radius:14px;background:#fff0ed;margin-bottom:14px;color:#692d28;font-size:12px}.j-first-tier span{font-weight:800}.j-first-tier strong{font-weight:950}.j-progress-copy{margin:8px 0 12px;text-align:left;color:#6f655f;font-size:12px}.j-card-cta{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;min-height:50px;border-radius:16px;background:linear-gradient(180deg,#ff443f,#ef2d2c);color:#fff;font-weight:950;font-size:15px;box-shadow:0 10px 22px rgba(239,45,44,.18)}.j-card-cta b{font-size:19px;line-height:1}.j-safe-copy{display:block;text-align:center;margin-top:9px;color:#9b8e87;font-size:10px}.j-buyer-empty{padding:28px}
.j-flash-stack{display:grid;gap:10px;margin-bottom:16px}
@media(max-width:620px){.j-buyer-region-card{grid-template-columns:auto 1fr;padding:14px}.j-region-change{grid-column:1/-1;width:100%;min-height:44px}.j-local-discovery{padding:20px;border-radius:24px}.j-local-discovery h2{font-size:29px}.j-local-proof span{font-size:9px}.j-buyer-card-media{height:auto;aspect-ratio:1.35/1}.j-buyer-price-block strong{font-size:22px}.j-buyer-section-head h2{font-size:24px}}
@media(max-width:380px){.j-local-discovery h2{font-size:26px}.j-buyer-card-body{padding:15px}.j-buyer-price-block{grid-template-columns:1fr}.j-first-tier{align-items:flex-start;flex-direction:column;gap:2px}}
