.j-buyer-offer-modal{width:min(680px,100%)}
.j-offer-modal-img{width:100%;height:250px;object-fit:cover;border-radius:22px}
.j-modal-price-summary{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:16px 0}.j-modal-price-summary>div{padding:14px 16px;border:1px solid rgba(54,37,30,.08);border-radius:16px;background:#fff}.j-modal-price-summary small{display:block;font-size:11px;font-weight:850;letter-spacing:.08em;color:#8b817c}.j-modal-price-summary s,.j-modal-price-summary strong{display:block;margin-top:6px;font-size:22px}.j-modal-price-summary strong{color:#ff3b36}
.j-tier-picker-head{margin:18px 0 10px}.j-tier-picker-head h3{margin:6px 0 4px;font-size:24px;line-height:1.12}.j-tier-picker-head p{margin:0;color:var(--muted);line-height:1.45}
.j-tier-choice-list{display:grid;gap:9px}.j-tier-choice{width:100%;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:12px;padding:14px 15px;border:1px solid rgba(66,43,34,.10);background:#fff;border-radius:18px;text-align:left;transition:.16s ease;box-shadow:0 5px 14px rgba(50,28,20,.025)}.j-tier-choice:active{transform:scale(.992)}.j-tier-choice.selected{border-color:#ff3b36;background:#fff1ef;box-shadow:0 9px 22px rgba(255,59,54,.10)}
.j-tier-radio{width:24px;height:24px;border:2px solid #d8cfca;border-radius:50%;display:grid;place-items:center}.j-tier-radio i{width:12px;height:12px;border-radius:50%;background:transparent}.j-tier-choice.selected .j-tier-radio{border-color:#ff3b36}.j-tier-choice.selected .j-tier-radio i{background:#ff3b36}.j-tier-choice-main strong,.j-tier-choice-price strong{display:block;font-size:17px;color:#171311}.j-tier-choice-main small,.j-tier-choice-price small{display:block;margin-top:4px;color:#817873;font-size:12px}.j-tier-choice-price{text-align:right}.j-tier-choice-price strong{color:#ff3b36;font-size:19px}
.j-tier-selection{margin-top:12px;padding:13px 15px;background:#f8f3f0;border-radius:15px}.j-tier-selection span,.j-tier-selection small{display:block;color:#7d746f;font-size:12px}.j-tier-selection strong{display:block;margin:3px 0;font-size:16px}.j-safe-copy.center{display:block;text-align:center;margin-top:9px}
.j-my-target{margin:12px 0;padding:13px 14px;border-radius:15px;background:#fff1ef;border:1px solid rgba(255,59,54,.12)}.j-my-target span,.j-my-target small{display:block}.j-my-target span{font-size:10px;font-weight:900;letter-spacing:.09em;color:#ff3b36}.j-my-target strong{display:block;margin:4px 0;font-size:16px}.j-my-target small{color:#766d69}.j-my-target.needs-choice{background:#fff8e9;border-color:#f0d9a3}.j-my-target.needs-choice span{color:#9a7019}
.j-joined-success{text-align:center}.j-success-mark{width:76px;height:76px;border-radius:50%;display:grid;place-items:center;margin:0 auto 14px;background:#e9faf3;color:#159b6f;font-size:38px;font-weight:900}.j-joined-success h2{font-size:30px;margin:8px 0}.j-joined-success>p{color:var(--muted);line-height:1.5}.j-success-target{margin:18px 0;padding:18px;border-radius:20px;background:#fff1ef}.j-success-target span,.j-success-target small{display:block}.j-success-target span{font-size:12px;font-weight:850;color:#7d746f}.j-success-target strong{display:block;margin:5px 0;font-size:34px;color:#ff3b36}.j-success-target small{font-size:14px;color:#5f5753}.j-share-callout{display:flex;flex-direction:column;gap:4px;padding:14px 16px;margin-bottom:12px;border-radius:16px;background:#f7f4f2;text-align:left}.j-share-callout b{font-size:16px}.j-share-callout span{color:#756d68;font-size:13px}.j-share-btn{box-shadow:0 12px 26px rgba(255,59,54,.18)}
@media(max-width:480px){.j-offer-modal-img{height:220px}.j-modal-price-summary{grid-template-columns:1fr 1fr}.j-tier-choice{padding:13px 12px;gap:9px}.j-tier-choice-main strong{font-size:16px}.j-tier-choice-price strong{font-size:18px}.j-tier-picker-head h3{font-size:22px}}
