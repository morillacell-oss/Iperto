:root{--red:#ff3e37;--red2:#ed2528;--ink:#17120f;--muted:#746a65;--line:#eaded8;--soft:#fff3ef;--green:#159b64;--shadow:0 18px 52px rgba(58,28,18,.09);--shadow-soft:0 10px 30px rgba(58,28,18,.055);--shadow-red:0 18px 42px rgba(239,45,42,.18);--radius-xl:30px;--radius-lg:24px;--radius-md:18px}html{background:#fffaf8}body{background:radial-gradient(circle at 12% -8%,rgba(255,73,65,.08),transparent 26%),radial-gradient(circle at 92% 8%,rgba(255,176,157,.09),transparent 24%),linear-gradient(180deg,#fffaf8 0%,#fffdfc 42%,#fffaf8 100%);color:var(--ink)}body:before{content:"";position:fixed;inset:0;pointer-events:none;background-image:linear-gradient(rgba(255,255,255,.28),rgba(255,255,255,.28));z-index:-1}.j-shell{width:min(1200px,calc(100% - 32px))}.j-topbar{background:rgba(255,252,250,.82);backdrop-filter:blur(24px) saturate(145%);-webkit-backdrop-filter:blur(24px) saturate(145%);border-bottom:1px solid rgba(55,30,20,.055);box-shadow:0 5px 24px rgba(53,29,19,.025)}.j-topbar-inner{min-height:76px}.j-brand{gap:11px;font-size:25px;letter-spacing:-.05em}.j-brand-mark{filter:drop-shadow(0 7px 14px rgba(238,42,38,.18))}.j-brand-mark i{background:linear-gradient(145deg,#ff5c54,#ec2729)}.j-icon-btn,.j-avatar-btn{width:50px;height:50px;border-color:rgba(71,42,31,.08);background:rgba(255,255,255,.88);box-shadow:0 8px 24px rgba(50,28,18,.055);transition:transform .16s ease,box-shadow .16s ease,border-color .16s ease}.j-icon-btn:hover,.j-avatar-btn:hover{transform:translateY(-1px);box-shadow:0 12px 28px rgba(50,28,18,.09);border-color:rgba(255,62,55,.18)}.j-icon-btn:active,.j-avatar-btn:active{transform:scale(.96)}.j-view{animation:jPremiumEnter .28s cubic-bezier(.2,.8,.2,1)}@keyframes jPremiumEnter{from{opacity:.2;transform:translateY(9px)}to{opacity:1;transform:none}}.j-kicker{padding:8px 12px;background:linear-gradient(180deg,#fff4f2,#ffebe7);border:1px solid rgba(239,46,42,.08);box-shadow:inset 0 1px 0 rgba(255,255,255,.95);color:#e8332f}.j-btn{min-height:52px;border-radius:17px;letter-spacing:-.01em;transition:transform .15s ease,box-shadow .18s ease,background .18s ease,border-color .18s ease}.j-btn:not(:disabled):hover{transform:translateY(-1px)}.j-btn:not(:disabled):active{transform:scale(.985)}.j-btn.primary{background:linear-gradient(135deg,#ff514a 0%,#f13a35 48%,#e92328 100%);box-shadow:0 14px 30px rgba(235,39,39,.24),inset 0 1px 0 rgba(255,255,255,.25)}.j-btn.primary:hover{box-shadow:0 18px 36px rgba(235,39,39,.29)}.j-btn.secondary{background:rgba(255,255,255,.92);border:1px solid rgba(62,35,25,.09);box-shadow:0 6px 18px rgba(55,31,21,.035)}.j-btn.secondary:hover{border-color:rgba(240,55,50,.15);box-shadow:0 10px 24px rgba(55,31,21,.07)}.j-btn.ghost{background:linear-gradient(180deg,#fff5f3,#ffebe7);border:1px solid rgba(237,49,46,.08)}.j-btn.dark{background:linear-gradient(145deg,#201714,#120e0c);box-shadow:0 12px 28px rgba(22,14,11,.18)}.j-hero{padding-top:64px}.j-hero h1{letter-spacing:-.07em}.j-hero-card{border-color:rgba(73,41,30,.08);border-radius:32px;box-shadow:0 25px 70px rgba(66,34,22,.11)}.j-product-media{border-radius:24px}.j-proof span{background:rgba(255,255,255,.82);border-color:rgba(67,38,28,.08);box-shadow:0 5px 14px rgba(49,27,18,.025)}.j-cat{border-color:rgba(65,38,28,.08);background:rgba(255,255,255,.9);box-shadow:0 5px 16px rgba(50,29,20,.025);transition:transform .15s ease,box-shadow .15s ease,border-color .15s ease}.j-cat:hover{transform:translateY(-1px);box-shadow:0 9px 22px rgba(50,29,20,.06);border-color:rgba(241,54,50,.14)}.j-cat.active{background:linear-gradient(135deg,#ff4b44,#ed292b);box-shadow:0 10px 24px rgba(237,41,43,.2)}.j-offer{border-color:rgba(64,36,26,.075);border-radius:25px;box-shadow:0 12px 34px rgba(54,29,20,.055);transform:translateZ(0);transition:transform .2s cubic-bezier(.2,.8,.2,1),box-shadow .2s ease,border-color .2s ease}.j-offer:hover{transform:translateY(-4px);box-shadow:0 24px 50px rgba(58,30,20,.11);border-color:rgba(237,49,45,.13)}.j-offer:active{transform:scale(.992)}.j-offer-img{height:190px;overflow:hidden}.j-offer-img img{transition:transform .32s ease}.j-offer:hover .j-offer-img img{transform:scale(1.035)}.j-offer-img:after{content:"";position:absolute;inset:auto 0 0;height:42%;background:linear-gradient(180deg,transparent,rgba(29,15,11,.08));pointer-events:none}.j-offer-body{padding:17px}.j-offer-store{font-size:10px;letter-spacing:.035em;text-transform:uppercase}.j-offer h3{font-size:18px;letter-spacing:-.025em;line-height:1.18}.j-offer-prices strong{font-size:22px;letter-spacing:-.035em}.j-badge{border:1px solid rgba(255,255,255,.55);box-shadow:0 8px 18px rgba(41,23,16,.08);backdrop-filter:blur(8px)}.j-progress{height:10px;background:#f1e8e4}.j-progress i{box-shadow:0 0 12px rgba(242,54,48,.18)}.j-empty{border:1px dashed rgba(128,95,81,.24);background:linear-gradient(180deg,rgba(255,255,255,.9),rgba(255,249,246,.9));border-radius:26px;padding:38px;box-shadow:0 10px 30px rgba(55,31,21,.035)}.j-empty h3{color:#2b211d}.j-how article{border-color:rgba(70,39,29,.075);border-radius:24px;box-shadow:0 10px 28px rgba(55,30,20,.035);transition:transform .18s ease,box-shadow .18s ease}.j-how article:hover{transform:translateY(-3px);box-shadow:0 18px 36px rgba(55,30,20,.075)}.j-seller-banner{border-radius:34px;background:radial-gradient(circle at 85% 10%,rgba(255,76,68,.24),transparent 28%),linear-gradient(145deg,#1b1311,#2a1b17 64%,#3a221c);box-shadow:0 25px 60px rgba(33,18,13,.18)}.j-bottom-nav{bottom:max(12px,env(safe-area-inset-bottom));padding:7px;background:rgba(255,255,255,.87);backdrop-filter:blur(26px) saturate(150%);-webkit-backdrop-filter:blur(26px) saturate(150%);border:1px solid rgba(68,39,28,.09);border-radius:26px;box-shadow:0 20px 55px rgba(42,23,17,.15),inset 0 1px 0 rgba(255,255,255,.8)}.j-bottom-nav button{min-height:60px;border-radius:18px;transition:background .16s ease,color .16s ease,transform .14s ease}.j-bottom-nav button:active{transform:scale(.96)}.j-bottom-nav button.active{background:linear-gradient(180deg,#fff2ef,#ffe9e5);color:#e8322f;box-shadow:inset 0 1px 0 rgba(255,255,255,.9),0 7px 18px rgba(235,48,44,.075)}.j-bottom-nav button.active svg{filter:drop-shadow(0 4px 7px rgba(234,48,45,.14))}.j-business-hero{position:relative;overflow:hidden;background:radial-gradient(circle at 88% 12%,rgba(255,72,64,.11),transparent 28%),linear-gradient(135deg,#fff,#fff8f5 72%);border-color:rgba(70,40,29,.075);border-radius:30px;box-shadow:0 18px 48px rgba(58,30,20,.075)}.j-business-hero:after{content:"";position:absolute;width:190px;height:190px;border:1px solid rgba(255,76,69,.07);border-radius:50%;right:-70px;bottom:-120px}.j-business-logo{border-radius:22px;box-shadow:0 10px 28px rgba(47,27,18,.08);border:1px solid rgba(71,40,28,.06)}.j-business-info h1{letter-spacing:-.055em}.j-live{background:rgba(255,255,255,.82);border-color:rgba(63,35,25,.08);box-shadow:0 7px 20px rgba(52,28,19,.035)}.j-live i{animation:jLivePulse 1.9s ease-in-out infinite}@keyframes jLivePulse{0%,100%{box-shadow:0 0 0 4px rgba(21,155,100,.1)}50%{box-shadow:0 0 0 7px rgba(21,155,100,.03)}}.j-metrics{gap:13px}.j-metric{position:relative;overflow:hidden;border-color:rgba(70,40,28,.07);border-radius:24px;min-height:148px;background:linear-gradient(180deg,#fff,#fffdfc);box-shadow:0 12px 32px rgba(55,30,20,.04);transition:transform .18s ease,box-shadow .18s ease}.j-metric:hover{transform:translateY(-2px);box-shadow:0 18px 38px rgba(55,30,20,.075)}.j-metric:after{content:"";position:absolute;width:84px;height:84px;border-radius:50%;background:rgba(255,68,61,.035);right:-28px;top:-30px}.j-metric.hot{background:radial-gradient(circle at 92% 4%,rgba(255,255,255,.22),transparent 30%),linear-gradient(145deg,#ff5149,#e9262a);box-shadow:var(--shadow-red)}.j-metric strong{font-size:40px}.j-panel{border-color:rgba(68,39,28,.075);border-radius:26px;background:rgba(255,255,255,.92);box-shadow:0 13px 36px rgba(55,30,20,.045)}.j-panel h2{letter-spacing:-.045em}.j-chart-col i{box-shadow:0 7px 18px rgba(236,47,43,.12)}.j-list{gap:11px}.j-list-item{border-color:rgba(68,39,28,.07);border-radius:20px;box-shadow:0 6px 20px rgba(50,28,19,.025);transition:transform .16s ease,box-shadow .16s ease,border-color .16s ease}.j-list-item:hover{transform:translateY(-1px);box-shadow:0 12px 28px rgba(50,28,19,.065);border-color:rgba(238,53,49,.12)}.j-list-item:active{transform:scale(.995)}.j-list-img{border-radius:17px}.j-status{padding:6px 9px}.j-region-card{position:relative;overflow:hidden;background:radial-gradient(circle at 88% 15%,rgba(255,76,68,.10),transparent 30%),linear-gradient(145deg,#fff,#fff8f5);border-color:rgba(70,40,29,.075);border-radius:28px;box-shadow:0 15px 40px rgba(55,30,20,.055)}.j-region-card:after{content:"";position:absolute;width:130px;height:130px;border-radius:50%;border:1px solid rgba(255,76,68,.08);right:-48px;bottom:-75px}.j-region-card>*{position:relative;z-index:1}.j-buyer-header h1{letter-spacing:-.065em}.j-flash{border-radius:27px;background:radial-gradient(circle at 92% 15%,rgba(255,255,255,.22),transparent 28%),linear-gradient(120deg,#e8181f,#ff433d 57%,#ff654f);box-shadow:0 20px 48px rgba(232,30,35,.24)}.j-account-card{border-color:rgba(67,37,27,.075);border-radius:30px;background:linear-gradient(180deg,#fff,#fffdfc);box-shadow:0 20px 55px rgba(58,30,20,.08)}.j-overlay{background:rgba(30,18,14,.45)!important;backdrop-filter:blur(11px) saturate(115%);-webkit-backdrop-filter:blur(11px) saturate(115%)}.j-modal{border-radius:30px!important;border:1px solid rgba(255,255,255,.72)!important;background:linear-gradient(180deg,rgba(255,255,255,.99),rgba(255,252,250,.985))!important;box-shadow:0 34px 90px rgba(35,20,15,.28)!important;animation:jModalIn .22s cubic-bezier(.2,.9,.25,1)}@keyframes jModalIn{from{opacity:0;transform:translateY(14px) scale(.985)}to{opacity:1;transform:none}}.j-modal-head{margin-bottom:16px}.j-modal-head h2{letter-spacing:-.045em}.j-close{transition:transform .14s ease,background .14s ease}.j-close:hover{transform:rotate(5deg);background:#fff1ee}.j-tier-choice{border-color:rgba(69,39,29,.08)!important;border-radius:18px!important;background:#fff!important;box-shadow:0 7px 20px rgba(50,28,19,.025)!important;transition:transform .16s ease,box-shadow .16s ease,border-color .16s ease,background .16s ease!important}.j-tier-choice:not(:disabled):hover{transform:translateY(-1px);box-shadow:0 12px 27px rgba(50,28,19,.07)!important;border-color:rgba(239,55,50,.16)!important}.j-tier-choice.selected{background:linear-gradient(180deg,#fff4f1,#ffebe7)!important;border-color:rgba(239,55,50,.24)!important;box-shadow:0 11px 26px rgba(236,49,45,.09)!important}.j-tier-radio{box-shadow:inset 0 0 0 1px rgba(78,47,34,.08)}.j-achieved-panel{box-shadow:0 18px 42px rgba(239,53,50,.10)}.j-checkout-modal .j-form input,.j-checkout-modal .j-form select,.j-checkout-modal .j-form textarea,.j-form input,.j-form select,.j-form textarea{border-radius:16px;border-color:rgba(79,46,33,.11);background:#fff;box-shadow:inset 0 1px 0 rgba(255,255,255,.8);transition:border-color .16s ease,box-shadow .16s ease,background .16s ease}.j-checkout-modal .j-form input:focus,.j-checkout-modal .j-form select:focus,.j-checkout-modal .j-form textarea:focus,.j-form input:focus,.j-form select:focus,.j-form textarea:focus{border-color:#ff665f;box-shadow:0 0 0 4px rgba(255,79,72,.095)}.j-order-summary-top{border-radius:20px}.j-order-protection{border-radius:18px}.j-completion-alert{position:relative;overflow:hidden;border-radius:24px;background:radial-gradient(circle at 88% 15%,rgba(255,255,255,.22),transparent 28%),linear-gradient(135deg,#ff433d,#e92c2c);box-shadow:0 19px 45px rgba(235,46,43,.24);transition:transform .16s ease,box-shadow .16s ease}.j-completion-alert:hover{transform:translateY(-2px);box-shadow:0 24px 54px rgba(235,46,43,.29)}.j-completion-alert:after{content:"";position:absolute;inset:auto -30px -80px auto;width:140px;height:140px;border:1px solid rgba(255,255,255,.14);border-radius:50%}.j-achieved-run-card{background:linear-gradient(180deg,#fff,#fffdfc);border-color:rgba(70,40,29,.075);box-shadow:0 15px 38px rgba(55,30,20,.055)}.j-achieved-count{background:linear-gradient(180deg,#fff4f1,#ffebe7);border:1px solid rgba(240,53,49,.075)}.j-seller-order{border-radius:18px;background:linear-gradient(180deg,#fff,#fffdfc);box-shadow:0 9px 24px rgba(44,25,18,.04)}.j-seller-whatsapp-warning,.j-whatsapp-missing-card{border-radius:20px}.j-toast{border-radius:16px!important;background:rgba(25,18,15,.94)!important;backdrop-filter:blur(16px);box-shadow:0 14px 36px rgba(23,14,11,.24)!important}.j-price-action,.j-cancel-action{border-radius:22px!important}.j-price-action{background:linear-gradient(180deg,#fff8f5,#fff)!important;border:1px solid rgba(240,56,51,.09)!important}.j-cancel-action{background:linear-gradient(180deg,#fff9f8,#fff)!important;border:1px solid rgba(190,39,35,.09)!important}.j-confirm-cancel,.j-cancel-warning{border-radius:22px!important}.j-card-cta{border-radius:16px!important;transition:transform .15s ease,box-shadow .16s ease!important}.j-card-cta:active{transform:scale(.985)}:focus-visible{outline:3px solid rgba(255,71,64,.24);outline-offset:3px}@media(max-width:900px){.j-grid{grid-template-columns:repeat(2,1fr)}.j-metrics{grid-template-columns:repeat(2,1fr)}.j-panel-grid{grid-template-columns:1fr}}@media(max-width:640px){.j-shell{width:min(100% - 22px,1200px)}.j-topbar-inner{min-height:68px}.j-brand{font-size:22px}.j-icon-btn,.j-avatar-btn{width:46px;height:46px}.j-app-shell{padding-top:16px}.j-business-hero{padding:16px;border-radius:24px}.j-business-logo{width:60px;height:60px;border-radius:18px}.j-business-info h1{font-size:27px}.j-metrics{gap:9px}.j-metric{min-height:126px;padding:15px;border-radius:21px}.j-metric strong{font-size:34px;margin:18px 0 4px}.j-panel{padding:17px;border-radius:23px}.j-grid{gap:10px}.j-offer{border-radius:22px}.j-offer-img{height:154px}.j-offer-body{padding:14px}.j-offer h3{font-size:16px}.j-region-card{padding:17px;border-radius:24px}.j-region-card h2{font-size:24px}.j-bottom-nav{width:calc(100% - 18px);bottom:max(7px,env(safe-area-inset-bottom));border-radius:23px}.j-bottom-nav button{min-height:58px}.j-modal{border-radius:27px 27px 0 0!important}.j-completion-alert{border-radius:21px;padding:15px}.j-account-card{border-radius:25px;padding:19px}.j-empty{padding:30px 20px;border-radius:23px}}@media(max-width:390px){.j-grid{grid-template-columns:1fr}.j-offer-img{height:190px}.j-metrics{grid-template-columns:1fr 1fr}.j-metric{min-height:116px}.j-business-hero{align-items:flex-start}.j-live{font-size:9px;padding:8px 9px}.j-bottom-nav button{font-size:9px}.j-bottom-nav svg{width:21px;height:21px}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}